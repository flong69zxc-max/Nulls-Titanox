diff --git a/.github/workflows/titanox.yml b/.github/workflows/titanox.yml
index 3acc171..d31a1d0 100644
--- a/.github/workflows/titanox.yml
+++ b/.github/workflows/titanox.yml
@@ -13,6 +13,7 @@ on:
 
 permissions:
   contents: read
+  actions: write
 
 concurrency:
   group: titanox-${{ github.ref }}
@@ -79,6 +80,19 @@ jobs:
           cp "$dylib" out/Titanox.dylib
           file out/Titanox.dylib
 
+      - name: Drop old artifacts
+        continue-on-error: true
+        env:
+          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+          REPO: ${{ github.repository }}
+          NAME: Titanox
+        run: |
+          gh api "repos/${REPO}/actions/artifacts?per_page=100" \
+            --jq ".artifacts[] | select(.name==\"${NAME}\") | .id" \
+            | while read -r id; do
+                gh api -X DELETE "repos/${REPO}/actions/artifacts/${id}"
+              done
+
       - name: Upload Titanox.dylib
         uses: actions/upload-artifact@v4
         with:
