+int tnx_interp(int32_t *x, int32_t *y) {
+    uintptr_t client = tnx_client();
+    int32_t cx = 0;
+    int32_t cy = 0;
+
+    if (x) *x = 0;
+    if (y) *y = 0;
+    if (!client) return 0;
