+int tnx_snapshot(uintptr_t *objectOut, uintptr_t *arrayOut, int32_t *countOut) {
+    int tries;
+
+    for (tries = 0; tries < 8; tries++) {
+        uint32_t s1 = t_seq;
+        uintptr_t o;
+        uintptr_t a;
+        int32_t c;
+
+        if (s1 & 1u) continue;
+
+        o = t_pub_object;
+        a = t_pub_array;
+        c = t_pub_count;
+
+        __sync_synchronize();
+
+        if (t_seq != s1) continue;
+
+        if (objectOut) *objectOut = o;
+        if (arrayOut) *arrayOut = a;
+        if (countOut) *countOut = c;
+
+        return 1;
+    }
+
+    return 0;
+}
