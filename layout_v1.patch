+float tnx_seg_dist(float ax, float ay, float bx, float by, float px, float py) {
+    float vx = bx - ax;
+    float vy = by - ay;
+    float wx = px - ax;
+    float wy = py - ay;
+    float len2 = vx * vx + vy * vy;
+    float t = 0.0f;
+    float dx = 0.0f;
+    float dy = 0.0f;
+
+    if (len2 > 0.001f) t = (wx * vx + wy * vy) / len2;
+    if (t < 0.0f) t = 0.0f;
+    if (t > 1.0f) t = 1.0f;
+
+    dx = px - (ax + t * vx);
+    dy = py - (ay + t * vy);
+
+    return sqrtf(dx * dx + dy * dy);
+}
