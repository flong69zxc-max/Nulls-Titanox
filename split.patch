+             (double)(sLen > 0.5f ? (float)sumY / sLen : 0.0f),
+             (double)(mLen > 0.5f ? (float)dx / mLen : 0.0f),
+             (double)(mLen > 0.5f ? (float)dy / mLen : 0.0f),
