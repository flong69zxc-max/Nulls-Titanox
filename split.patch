+int g_cand_frame[TNX_CAND];
+
+int g_cand_changes[TNX_CAND];
+
+int g_dead_slot = -1;
+
+int g_dead_value = 0;
+
+int g_pending = 0;
+
+int g_pending_tick = 0;
+
+int g_pre[TNX_CAND];
+
+int g_prev_valid = 0;
+
+int g_respawn_tick = 0;
+
+int g_life_logs = 0;
