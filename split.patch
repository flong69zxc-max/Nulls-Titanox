-    for (int i = 0; i < OBJC_HOOK_MAX; i++) {
-        tnx_objc_hook_t *hook = &g_objc_hooks[i];
-
-        if (!hook->used || hook->sel != _cmd) continue;
-
-        bySelector = hook;
-        bySelectorCount++;
