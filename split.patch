-    if (!buf) return NULL;
-
-    memset(buf, 0, 16);
-
-    *(uint32_t *)(buf + 0) = (uint32_t)blen;
-    *(uint32_t *)(buf + 4) = (uint32_t)blen;
-
-    if (blen > 7) {
-        uint8_t *data = (uint8_t *)malloc(blen + 1);
-        if (!data) {
-            free(buf);
-            return NULL;
-        }
-
-        memcpy(data, utf8, blen);
-        data[blen] = 0;
-
-        *(void **)(buf + 8) = data;
-    } else {
-        memcpy(buf + 8, utf8, blen);
-    }
-
-    return buf;
