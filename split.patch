-const char *tnx_skip_compound(const char *p) {
-    char open = *p;
-    char close = (open == '{') ? '}' : ((open == '(') ? ')' : ']');
-    int depth = 0;
-
-    while (*p) {
-        if (*p == open) {
-            depth++;
-        } else if (*p == close) {
-            depth--;
-            if (depth == 0) {
-                p++;
-                break;
-            }
-        }
-
-        p++;
-    }
-
-    return p;
-}
