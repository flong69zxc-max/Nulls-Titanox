+    int dx = 0;
+    int dy = 0;
+    int moved = 0;
+    int ours = g_engaged_ticks;
+    long long sumX = 0;
+    long long sumY = 0;
+    float sLen = 0.0f;
+    float mLen = 0.0f;
+    float dot = 0.0f;
+    const char *align = "no-move";
+
+    if ((g_ticks_3 % 60) != 0) return;
+    if (!tnx_own(&ownX, &ownY)) return;
+
+    g_engaged_ticks = 0;
+
+    if (ctrl) {
+        tnx_read_i32(ctrl + TNX_CTRL_RAW_X_OFF, &backX);
